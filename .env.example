# =====================================================================
# PII Shield — Environment Configuration Template
# Copy this file to .env and configure for your local environment
# =====================================================================

# Operating Mode (true for hackathon evaluator demo, false for strict production)
DEMO_MODE=true

# Database Engine Selection ('sqlite' or 'postgres')
DB_ENGINE=sqlite

# SQLite Configuration (Used when DB_ENGINE=sqlite)
DB_PATH=backend/customers.db

# PostgreSQL Configuration (Used when DB_ENGINE=postgres)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# JWT Authentication (HS256)
# MANDATORY: In production (DEMO_MODE=false), set a high-entropy random secret
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Deterministic Masking Salt (Used for Analyst pseudonymized joins)
# MANDATORY: In production (DEMO_MODE=false), set a secret cryptographic salt
HASH_SALT=change-this-to-a-secure-salt-for-pseudonymization-2026

# CORS Allowed Origins (Comma-separated list of additional trusted frontend origins)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000

